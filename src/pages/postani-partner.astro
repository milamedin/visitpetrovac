---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiers = [
  { name: 'Samostalni apartman', price: 100, features: ['1 listing', 'Sve fotografije', 'Direktan kontakt sa gostima', 'Dodavanje na mapu'] },
  { name: 'Kuća do 5 jedinica', price: 200, features: ['Do 5 jedinica u jednom listingu', 'Sve fotografije', 'Direktan kontakt', 'Dodavanje na mapu'] },
  { name: 'Mini-hotel (6—15)', price: 350, features: ['Do 15 tipova soba', 'Više fotografija po jedinici', 'Premium pozicija na kategoriji', 'Dodavanje na mapu'] },
  { name: 'Hotel (16+)', price: 600, features: ['Neograničeni tipovi soba', 'Premium pozicija', 'Booking widget', 'Dedicated profil stranica'] },
  { name: 'Restoran', price: 150, features: ['Profil + meni', 'Galerija', 'Direktan kontakt', 'Dodavanje na mapu'] },
  { name: 'Rent-a-car', price: 150, features: ['Cijenovnik vozila', 'Galerija', 'WhatsApp / Booking link', 'Dodavanje na mapu'] },
];

const addons = [
  {
    name: 'Premium pozicija',
    price: '+150€/god',
    text: 'Pinovan na vrh kategorije, badge "Premium" na kartici, prvi u sortiranju "Preporučeno".',
  },
  {
    name: 'Profesionalno fotografisanje',
    price: 'od 80€',
    text: 'Lokalni fotograf dolazi na adresu, 10—30 obrađenih fotografija, uključujući dronske snimke. Plaća se jednokratno.',
  },
  {
    name: 'Promotivni video',
    price: 'od 150€',
    text: '60-sekundni vertikalni video za Instagram + 30-sekundni za sajt. Idealno za aktivnosti i hotele. Lokacija + dron + montaža.',
  },
];

const benefits = [
  {
    icon: 'M3 3h18v4H3V3zm0 7h12v4H3v-4zm0 7h18v4H3v-4z',
    title: 'Bez provizije',
    text: 'Plaćaš fiksnu godišnju pretplatu. Ne uzimamo procenat od rezervacija — gosti te plaćaju direktno.',
  },
  {
    icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
    title: 'Direktan kontakt sa gostom',
    text: 'Telefon, WhatsApp, email — gost te kontaktira odmah, bez chat sistema i bez čekanja na potvrdu.',
  },
  {
    icon: 'M12 2 4 7v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V7l-8-5z',
    title: 'Lokalni autoritet',
    text: '@visitpetrovac (2400+ pratilaca) + organska Google posjeta na "petrovac" (91k/mjesec) — gosti dolaze sa naslovne.',
  },
];
---

<BaseLayout
  title="Postani partner — VisitPetrovac"
  description="Pridruži se direktorijumu apartmana, restorana i izleta u Petrovcu. Fiksna godišnja pretplata, bez provizije."
>
  <section class="pp-hero">
    <div class="container pp-hero__inner">
      <span class="eyebrow">Za vlasnike u Petrovcu</span>
      <h1 class="pp-hero__title">
        Tvoji budući gosti su <em>već tu</em> — traže te na Google-u i Instagramu.
      </h1>
      <p class="pp-hero__lead">
        Pridruži se direktorijumu, dobij stalan saobraćaj i direktan kontakt sa gostima.
        Fiksna godišnja pretplata. Bez provizije, bez procenata, bez posrednika.
      </p>
      <div class="pp-hero__actions">
        <a href="#cjenovnik" class="btn btn--primary btn--lg">Vidi cjenovnik</a>
        <a href="#kontakt" class="btn btn--ghost btn--lg">Pošalji upit</a>
      </div>
    </div>
  </section>

  <section class="section pp-benefits">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Zašto VisitPetrovac</span>
        <h2 class="section-title">Tri stvari koje radimo <em>drugačije</em></h2>
      </header>

      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit">
            <div class="benefit__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={b.icon} />
              </svg>
            </div>
            <h3 class="benefit__title">{b.title}</h3>
            <p class="benefit__text">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="cjenovnik" class="section pp-pricing">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Cjenovnik</span>
        <h2 class="section-title">Fiksna godišnja pretplata.<br /><em>Bez procenata.</em></h2>
        <p class="section-lead">
          Birasi paket prema veličini objekta. Plaćaš jednom godišnje. Featured pozicija je dodatnih +150€.
        </p>
      </header>

      <div class="pricing-grid">
        {tiers.map((t, i) => (
          <div class:list={['tier', { 'tier--featured': i === 1 }]}>
            <div class="tier__name">{t.name}</div>
            <div class="tier__price">
              <strong>{t.price}€</strong>
              <span class="tier__per">/ godišnje</span>
            </div>
            <ul class="tier__features">
              {t.features.map((f) => (
                <li>
                  <span class="tier__check" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="addons">
        <div class="addons__header">
          <span class="eyebrow">Dodatni servisi</span>
          <h3 class="addons__title">Pomažemo da se objekat <em>bolje predstavi</em></h3>
          <p class="addons__lead">
            Ako nemaš kvalitetne fotke ili želiš pravi promo materijal — naručimo profesionalca u tvoje ime. Plaća se jednokratno, posebno od godišnje pretplate.
          </p>
        </div>
        <div class="addons__grid">
          {addons.map((a) => (
            <div class="addon">
              <div class="addon__price">{a.price}</div>
              <h4 class="addon__name">{a.name}</h4>
              <p class="addon__text">{a.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="kontakt" class="section section--tight pp-cta">
    <div class="container pp-cta__inner">
      <div>
        <span class="eyebrow eyebrow--light">Spreman/na?</span>
        <h2 class="pp-cta__title">Javi se i razgovaramo</h2>
        <p class="pp-cta__lead">
          Pošalji email ili WhatsApp poruku — odgovaramo u istom danu, najčešće za sat-dva.
        </p>
      </div>
      <div class="pp-cta__actions">
        <a href="https://wa.me/38267000000" class="btn btn--accent btn--lg" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347" />
          </svg>
          WhatsApp
        </a>
        <a href="mailto:partner@visitpetrovac.com" class="btn btn--ghost btn--lg">Email</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pp-hero {
    background: linear-gradient(135deg, var(--c-cream-warm) 0%, var(--c-bg) 100%);
    padding: clamp(6rem, 14vw, 10rem) 0 clamp(4rem, 10vw, 7rem);
  }
  .pp-hero__inner {
    max-width: 820px;
  }
  .pp-hero__title {
    margin-top: var(--sp-4);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1.05;
    text-wrap: balance;
  }
  .pp-hero__title em {
    font-style: italic;
    color: var(--c-accent);
  }
  .pp-hero__lead {
    margin-top: var(--sp-5);
    font-size: var(--fs-lg);
    color: var(--c-ink-soft);
    line-height: 1.6;
    max-width: 60ch;
  }
  .pp-hero__actions {
    margin-top: var(--sp-8);
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  /* Benefits */
  .pp-benefits .section-title em {
    font-style: italic;
    color: var(--c-accent);
  }
  .section-header {
    max-width: 720px;
    margin-bottom: var(--sp-12);
  }
  .section-header--center {
    margin-inline: auto;
    text-align: center;
  }
  .section-title {
    font-size: var(--fs-3xl);
    font-weight: 400;
    line-height: 1.06;
    margin-block: var(--sp-2) var(--sp-4);
  }
  .section-lead {
    font-size: var(--fs-lg);
    color: var(--c-ink-soft);
  }
  .section-header--center .section-lead {
    margin-inline: auto;
  }

  .benefits-grid {
    display: grid;
    gap: var(--sp-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .benefits-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .benefit {
    padding: var(--sp-8);
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-2xl);
  }
  .benefit__icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    background: var(--c-accent-soft);
    color: var(--c-accent);
    border-radius: var(--r-lg);
    margin-bottom: var(--sp-5);
  }
  .benefit__title {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-2);
  }
  .benefit__text {
    color: var(--c-ink-soft);
    line-height: 1.6;
  }

  /* Pricing */
  .pp-pricing {
    background: var(--c-cream-warm);
  }
  .pp-pricing .section-title em {
    font-style: italic;
    color: var(--c-accent);
  }
  .pricing-grid {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .pricing-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .tier {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .tier:hover {
    transform: translateY(-3px);
    border-color: var(--c-accent);
  }
  .tier--featured {
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px rgba(15, 163, 163, 0.12);
  }
  .tier__name {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--c-accent);
  }
  .tier__price {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    border-bottom: 1px solid var(--c-border);
    padding-bottom: var(--sp-4);
  }
  .tier__price strong {
    font-family: var(--ff-serif);
    font-size: var(--fs-3xl);
    font-weight: 400;
    color: var(--c-ink);
    line-height: 1;
  }
  .tier__per {
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }
  .tier__features {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }
  .tier__features li {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .tier__check {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--c-accent);
    color: var(--c-cream);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Addons */
  .addons {
    margin-top: var(--sp-16);
    padding-top: var(--sp-12);
    border-top: 1px solid var(--c-border);
  }
  .addons__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--sp-10);
  }
  .addons__title {
    font-size: var(--fs-2xl);
    font-weight: 400;
    margin: var(--sp-2) 0 var(--sp-3);
  }
  .addons__title em {
    font-style: italic;
    color: var(--c-accent);
  }
  .addons__lead {
    color: var(--c-ink-soft);
    line-height: 1.55;
  }
  .addons__grid {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .addons__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .addon {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: var(--sp-6);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .addon:hover {
    transform: translateY(-3px);
    border-color: var(--c-accent);
  }
  .addon__price {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--c-accent);
    margin-bottom: var(--sp-2);
  }
  .addon__name {
    font-family: var(--ff-serif);
    font-size: var(--fs-xl);
    font-weight: 500;
    margin-bottom: var(--sp-2);
    line-height: 1.2;
  }
  .addon__text {
    color: var(--c-ink-soft);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* CTA */
  .pp-cta__inner {
    background: var(--c-ink);
    color: var(--c-cream);
    border-radius: var(--r-2xl);
    padding: clamp(var(--sp-8), 5vw, var(--sp-16));
    display: grid;
    gap: var(--sp-8);
    align-items: center;
    background-image: radial-gradient(circle at 100% 0%, rgba(15, 163, 163, 0.18), transparent 50%);
  }
  @media (min-width: 760px) {
    .pp-cta__inner { grid-template-columns: 1fr auto; gap: var(--sp-12); }
  }
  .pp-cta__title {
    color: var(--c-cream);
    font-size: var(--fs-2xl);
    margin-block: var(--sp-2) var(--sp-3);
  }
  .pp-cta__lead {
    color: rgba(250, 246, 238, 0.78);
    max-width: 50ch;
  }
  .pp-cta__actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .eyebrow--light {
    color: var(--c-accent);
  }
</style>

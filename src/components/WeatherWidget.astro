---
import { getWeather, describeWeather, dayName } from '../lib/weather';
import { useI18n, localeMeta } from '../i18n';

interface Props {
  variant?: 'compact' | 'full';
}

const { variant = 'compact' } = Astro.props;
const { locale } = useI18n(Astro);
const localeTag = localeMeta[locale].htmlLang;

const data = await getWeather();
---

{
  data ? (
    <div class:list={['wx', `wx--${variant}`]}>
      <div class="wx__current">
        <div class="wx__location">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke-linejoin="round" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Petrovac na Moru
        </div>
        <div class="wx__now">
          <span class="wx__icon">{describeWeather(data.current.weather_code).icon}</span>
          <strong class="wx__temp">{Math.round(data.current.temperature)}°</strong>
          <div class="wx__meta">
            <span>{describeWeather(data.current.weather_code).label}</span>
            {data.sea && <span class="wx__sea">More: {Math.round(data.sea.temperature)}°</span>}
          </div>
        </div>
      </div>
      <div class="wx__week">
        {data.daily.slice(0, 7).map((d, i) => (
          <div class="wx__day">
            <span class="wx__day-name">{i === 0 ? 'Danas' : dayName(d.date, localeTag)}</span>
            <span class="wx__day-icon">{describeWeather(d.weather_code).icon}</span>
            <span class="wx__day-temps">
              <strong>{Math.round(d.temp_max)}°</strong>
              <span class="wx__day-min">{Math.round(d.temp_min)}°</span>
            </span>
          </div>
        ))}
      </div>
      <a href="/vrijeme" class="wx__more">Detaljna prognoza →</a>
    </div>
  ) : (
    <div class="wx wx--placeholder">
      <p>Vremenska prognoza trenutno nedostupna.</p>
    </div>
  )
}

<style>
  .wx {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .wx__current {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .wx__location {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: var(--c-accent);
  }
  .wx__location svg { color: var(--c-accent); }

  .wx__now {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .wx__icon {
    font-size: 2.5rem;
    line-height: 1;
  }
  .wx__temp {
    font-family: var(--ff-serif);
    font-size: 3rem;
    font-weight: 400;
    color: var(--c-ink);
    line-height: 1;
  }
  .wx__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }
  .wx__sea {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .wx__week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--sp-1);
    border-top: 1px solid var(--c-border);
    padding-top: var(--sp-4);
  }
  .wx__day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    padding: var(--sp-1);
    border-radius: var(--r-sm);
  }
  .wx__day-name {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    font-weight: 600;
  }
  .wx__day-icon {
    font-size: 1.25rem;
  }
  .wx__day-temps {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.2;
  }
  .wx__day-temps strong {
    font-size: var(--fs-sm);
    color: var(--c-ink);
    font-weight: 600;
  }
  .wx__day-min {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }

  .wx__more {
    font-size: var(--fs-sm);
    color: var(--c-accent);
    text-decoration: none;
    font-weight: 600;
    text-align: center;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--c-border);
  }
  .wx__more:hover { text-decoration: underline; }

  .wx--full .wx__temp {
    font-size: 4.5rem;
  }
  .wx--full .wx__icon {
    font-size: 3.5rem;
  }

  .wx--placeholder {
    text-align: center;
    color: var(--c-muted);
  }
</style>

---
import { useI18n } from '../i18n';

const { t, url } = useI18n(Astro);

interface Props {
  listingId: string;
  listingTitle: string;
  priceFrom?: number;
  priceUnit?: string;
}

const { listingId, listingTitle, priceFrom, priceUnit } = Astro.props;

const unitLabels: Record<string, string> = {
  per_night: t('common.unit.night'),
  per_person: t('common.unit.person'),
  per_day: t('common.unit.day'),
  per_meal: t('common.unit.meal'),
  fixed: '',
};
const unitLabel = priceUnit ? unitLabels[priceUnit] : '';

const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
---

<aside class="tour-form" data-listing={listingId}>
  {priceFrom !== undefined && (
    <div class="tour-form__price">
      <span class="tour-form__price-from">{t('common.from')}</span>
      <strong>{priceFrom}€</strong>
      {unitLabel && <span class="tour-form__price-unit">/ {unitLabel}</span>}
    </div>
  )}

  <h3 class="tour-form__title">{t('tour.title')}</h3>
  <p class="tour-form__lead">{t('tour.lead')}</p>

  <form id="tourForm" novalidate>
    <input type="hidden" name="listing_id" value={listingId} />
    <input type="hidden" name="listing_title" value={listingTitle} />
    <input
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      class="hp"
      aria-hidden="true"
    />

    <div class="field">
      <label for="tf-name">{t('tour.field.name')} <span aria-hidden="true">*</span></label>
      <input id="tf-name" name="name" type="text" required minlength="2" maxlength="80" autocomplete="name" />
    </div>

    <div class="field-row">
      <div class="field">
        <label for="tf-email">{t('tour.field.email')} <span aria-hidden="true">*</span></label>
        <input id="tf-email" name="email" type="email" required maxlength="120" autocomplete="email" />
      </div>
      <div class="field">
        <label for="tf-phone">{t('tour.field.phone')} <span aria-hidden="true">*</span></label>
        <input id="tf-phone" name="phone" type="tel" required maxlength="40" autocomplete="tel" placeholder="+382..." />
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="tf-date">{t('tour.field.date')} <span aria-hidden="true">*</span></label>
        <input id="tf-date" name="tour_date" type="date" required min={tomorrow} />
      </div>
      <div class="field">
        <label for="tf-persons">{t('tour.field.persons')} <span aria-hidden="true">*</span></label>
        <input id="tf-persons" name="persons" type="number" required min="1" max="50" value="2" inputmode="numeric" />
      </div>
    </div>

    <div class="field">
      <label for="tf-language">{t('tour.field.language')}</label>
      <select id="tf-language" name="language">
        <option value="sr">Crnogorski</option>
        <option value="en">English</option>
        <option value="ru">Русский</option>
        <option value="de">Deutsch</option>
        <option value="fr">Français</option>
      </select>
    </div>

    <div class="field">
      <label for="tf-message">{t('tour.field.message')}</label>
      <textarea id="tf-message" name="message" rows="3" maxlength="600" placeholder={t('tour.field.message.placeholder')}></textarea>
    </div>

    <button type="submit" class="btn btn--primary btn--lg" id="tfSubmit">
      {t('tour.submit')}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <p class="tour-form__notice">
      <a href={url('/info/uslovi')}>{t('tour.notice')}</a>
    </p>
  </form>

  <div class="tour-form__success" hidden id="tfSuccess">
    <div class="tour-form__success-icon" aria-hidden="true">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <h3>{t('tour.success.title')}</h3>
    <p>{t('tour.success.text')}</p>
  </div>

  <div class="tour-form__error" hidden id="tfError">
    <p>{t('tour.error.text')} <button type="button" id="tfRetry" class="link">{t('tour.error.retry')}</button></p>
  </div>
</aside>

<style>
  .tour-form {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: var(--sp-6);
    box-shadow: var(--sh-md);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .tour-form__price {
    display: flex;
    align-items: baseline;
    gap: var(--sp-1);
  }
  .tour-form__price-from {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
  }
  .tour-form__price strong {
    font-family: var(--ff-serif);
    font-size: var(--fs-2xl);
    font-weight: 400;
    color: var(--c-ink);
    margin-inline-start: var(--sp-1);
  }
  .tour-form__price-unit {
    font-size: var(--fs-base);
    color: var(--c-muted);
  }

  .tour-form__title {
    font-size: var(--fs-xl);
    font-weight: 500;
    margin-bottom: var(--sp-1);
  }
  .tour-form__lead {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
    line-height: 1.55;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .field-row {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 480px) {
    .field-row { grid-template-columns: 1fr 1fr; }
  }

  label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
    font-weight: 600;
  }
  label span {
    color: var(--c-accent);
    margin-inline-start: 2px;
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  input[type='date'],
  input[type='number'],
  select,
  textarea {
    border: 1px solid var(--c-border-strong);
    border-radius: var(--r-md);
    padding: 0.7rem 0.875rem;
    font-size: var(--fs-base);
    color: var(--c-ink);
    background: var(--c-white);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    width: 100%;
    font-family: inherit;
  }
  textarea {
    resize: vertical;
    min-height: 80px;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px rgba(15, 163, 163, 0.16);
  }
  input[aria-invalid='true'],
  select[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #c84a4a;
    box-shadow: 0 0 0 3px rgba(200, 74, 74, 0.12);
  }

  .hp {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
  }

  .tour-form__notice {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    text-align: center;
    line-height: 1.55;
  }
  .tour-form__notice a {
    text-decoration: underline;
  }

  /* Success */
  .tour-form__success,
  .tour-form__error {
    text-align: center;
    padding: var(--sp-4) 0;
    animation: revealFade var(--dur-slow) var(--ease-out);
  }
  .tour-form__success-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--sp-4);
    display: grid;
    place-items: center;
    background: var(--c-accent);
    color: var(--c-cream);
    border-radius: 50%;
  }
  .tour-form__success h3 {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-2);
  }
  .tour-form__success p {
    color: var(--c-ink-soft);
    line-height: 1.6;
    font-size: var(--fs-sm);
  }
  .tour-form__success a {
    color: var(--c-accent);
    text-decoration: underline;
  }

  .tour-form__error p {
    color: #c84a4a;
    font-size: var(--fs-sm);
  }
  .tour-form__error .link {
    color: var(--c-accent);
    text-decoration: underline;
    cursor: pointer;
  }

  @keyframes revealFade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  [hidden] { display: none !important; }
</style>

<script>
  const form = document.getElementById('tourForm') as HTMLFormElement | null;
  const success = document.getElementById('tfSuccess') as HTMLElement | null;
  const error = document.getElementById('tfError') as HTMLElement | null;
  const submitBtn = document.getElementById('tfSubmit') as HTMLButtonElement | null;
  const retryBtn = document.getElementById('tfRetry');

  function reset() {
    if (!form || !success || !error) return;
    form.hidden = false;
    success.hidden = true;
    error.hidden = true;
    form.reset();
  }
  retryBtn?.addEventListener('click', reset);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !success || !error || !submitBtn) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitBtn.disabled = true;
    const original = submitBtn.innerHTML;
    submitBtn.innerHTML = 'Šaljem...';

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch('/api/tour-inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      form.hidden = true;
      success.hidden = false;
    } catch (err) {
      console.error('[tour-inquiry] failed', err);
      error.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = original;
    }
  });
</script>

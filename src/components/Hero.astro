---
import SearchBar from './SearchBar.astro';
import Picture from './Picture.astro';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro);

interface Props {
  image?: string;
}

const { image = '/hero-petrovac.jpg' } = Astro.props;

const eyebrow = t('hero.eyebrow');
const title = t('hero.title.line1');
const emphasis = t('hero.title.line2');
const subtitle = t('hero.subtitle');
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <Picture src={image} alt="" loading="eager" fetchpriority="high" decoding="async" />
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <span class="hero__eyebrow">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        {eyebrow}
      </span>

      <h1 class="hero__title">
        {title}<br />
        <em>{emphasis}</em>
      </h1>

      <p class="hero__subtitle">{subtitle}</p>

      <div class="hero__search">
        <SearchBar />
      </div>

      <div class="hero__stats">
        <div class="hero__stat">
          <strong>40+</strong>
          <span>{t('hero.stat.objects')}</span>
        </div>
        <span class="hero__stat-divider" aria-hidden="true"></span>
        <div class="hero__stat">
          <strong>0%</strong>
          <span>{t('hero.stat.commission')}</span>
        </div>
        <span class="hero__stat-divider" aria-hidden="true"></span>
        <div class="hero__stat">
          <strong>2400+</strong>
          <span>{t('hero.stat.instagram')}</span>
        </div>
      </div>
    </div>
  </div>

  <a href="#explore" class="hero__scroll" aria-label={t('hero.scroll')}>
    <span class="hero__scroll-text">{t('hero.scroll')}</span>
    <span class="hero__scroll-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 5v14M19 12l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(4rem, 12vw, 8rem);
    padding-top: clamp(5rem, 12vw, 8rem);
    color: var(--c-cream);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(7, 59, 76, 0.7) 0%, rgba(7, 59, 76, 0.45) 35%, rgba(7, 59, 76, 0.85) 100%),
      linear-gradient(135deg, rgba(7, 59, 76, 0.55) 0%, transparent 55%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__content {
    max-width: 780px;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-cream);
  }
  .hero__eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 3px rgba(196, 95, 60, 0.3);
    animation: pulse 2s var(--ease) infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.18); }
  }

  .hero__title {
    margin-top: var(--sp-5);
    font-family: var(--ff-serif);
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--c-cream);
    text-wrap: balance;
  }

  .hero__title em {
    font-style: italic;
    font-weight: 400;
    color: #5fdada;
  }

  .hero__subtitle {
    margin-top: var(--sp-5);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.55;
    max-width: 50ch;
    color: rgba(250, 246, 238, 0.88);
  }

  .hero__search {
    margin-top: var(--sp-8);
  }

  .hero__stats {
    margin-top: var(--sp-10);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero__stat strong {
    font-family: var(--ff-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    color: var(--c-cream);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero__stat span {
    font-size: var(--fs-xs);
    color: rgba(250, 246, 238, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero__stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(250, 246, 238, 0.2);
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--sp-6);
    left: 50%;
    transform: translateX(-50%);
    display: none;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.5rem 1rem 0.5rem 1.125rem;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    border-radius: var(--r-full);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--c-cream);
    transition: background var(--dur) var(--ease);
    z-index: 1;
  }
  .hero__scroll:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .hero__scroll-arrow {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--c-accent);
    animation: bounce 2.4s var(--ease) infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (min-width: 880px) {
    .hero__scroll {
      display: inline-flex;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow-dot,
    .hero__scroll-arrow {
      animation: none;
    }
  }
</style>

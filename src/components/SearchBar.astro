---
import { useI18n } from '../i18n';

const { t, url } = useI18n(Astro);

interface Props {
  placeholder?: string;
  variant?: 'hero' | 'compact';
}

const { placeholder = t('hero.search.placeholder'), variant = 'hero' } = Astro.props;
const action = url('/search');
---

<form class:list={['searchbar', `searchbar--${variant}`]} action={action} method="get" role="search">
  <span class="searchbar__icon" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="7" />
      <path d="m21 21-4.3-4.3" stroke-linecap="round" />
    </svg>
  </span>
  <input
    type="search"
    name="q"
    placeholder={placeholder}
    aria-label={t('common.search.action')}
    autocomplete="off"
  />
  <button type="submit" class="searchbar__submit" aria-label={t('common.search.action')}>
    <span class="searchbar__submit-text">{t('common.search.action')}</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</form>

<style>
  .searchbar {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--c-white);
    border-radius: var(--r-full);
    padding: 6px 6px 6px var(--sp-5);
    box-shadow: var(--sh-lg);
    width: 100%;
    max-width: 540px;
  }

  .searchbar__icon {
    color: var(--c-muted);
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }

  .searchbar input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 0.875rem 0;
    font-size: var(--fs-base);
    color: var(--c-ink);
    outline: none;
    min-width: 0;
  }

  .searchbar input::placeholder {
    color: var(--c-muted);
  }

  .searchbar__submit {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.75rem 1.25rem;
    background: var(--c-ink);
    color: var(--c-cream);
    border-radius: var(--r-full);
    font-weight: 600;
    font-size: var(--fs-sm);
    transition: background var(--dur) var(--ease);
    flex-shrink: 0;
  }

  .searchbar__submit:hover {
    background: var(--c-accent);
  }

  .searchbar__submit-text {
    display: none;
  }

  @media (min-width: 480px) {
    .searchbar__submit-text {
      display: inline;
    }
  }

  .searchbar--compact {
    box-shadow: var(--sh-sm);
    border: 1px solid var(--c-border);
    padding: 4px 4px 4px var(--sp-4);
  }
  .searchbar--compact input {
    padding: 0.625rem 0;
    font-size: var(--fs-sm);
  }
  .searchbar--compact .searchbar__submit {
    padding: 0.5rem 1rem;
  }
</style>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useI18n, locales, localeMeta, defaultLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { t, locale, urlFor, pathWithoutLocale } = useI18n(Astro);

const {
  title = 'VisitPetrovac — Petrovac, Montenegro',
  description = t('hero.subtitle'),
  ogImage = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const meta = localeMeta[locale];
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const alternates = locales.map((l) => ({
  locale: l,
  hreflang: localeMeta[l].htmlLang,
  href: new URL(
    l === defaultLocale ? pathWithoutLocale : `/${l}${pathWithoutLocale === '/' ? '' : pathWithoutLocale}`,
    Astro.site,
  ).toString(),
}));
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#073b4c" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pathWithoutLocale, Astro.site).toString()}
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter+Tight:wght@400;500;600;700&display=swap"
    />

    <slot name="head" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-49FR3CETGQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-49FR3CETGQ');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t('common.skipToContent')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:global>
      .skip-link {
        position: absolute;
        top: 8px;
        left: 8px;
        background: var(--c-ink);
        color: var(--c-cream);
        padding: 8px 16px;
        border-radius: var(--r-md);
        z-index: 100;
        transform: translateY(-200%);
        transition: transform var(--dur) var(--ease);
      }
      .skip-link:focus {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
